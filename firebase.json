{
    "functions": {
        "source": "functions",
        "runtime": "nodejs22"
    },
    "firestore": {
        "rules": "firestore.rules",
        "indexes": "firestore.indexes.json"
    },
    "storage": {
        "rules": "storage.rules"
    },
    "hosting": {
        "public": ".",
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**",
            "functions/**",
            "tests/**",
            "test-results/**",
            "output/**",
            "firestore.rules",
            "firestore.indexes.json",
            "storage.rules",
            "firebase-debug*.log",
            "QR-PAYMENTS.md",
            "migrate-companyId.js"
        ],
        "rewrites": [
            {
                "source": "/:store/admin/admin.html",
                "destination": "/admin/admin.html"
            },
            {
                "source": "/:store",
                "destination": "/index.html"
            },
            {
                "source": "/:store/",
                "destination": "/index.html"
            }
        ]
    }
}
